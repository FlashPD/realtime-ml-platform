{
  "uid": "tripml-serving",
  "title": "TripML Serving",
  "description": "Local serving operations. Use exported benchmark evidence for release latency claims.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "tripml",
    "serving"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Prediction responses by status",
      "description": "Completed /v1/eta responses, including input validation failures. This is not offered load or dropped client arrivals.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(tripml_prediction_requests_total{job=\"tripml-serving\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server latency P50 / P95 / P99",
      "description": "Histogram estimates aggregated across pods. Includes server handling and broker wait; excludes network and client dispatch delay. Compare client benchmark evidence separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tripml_prediction_request_duration_seconds_bucket{job=\"tripml-serving\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tripml_prediction_request_duration_seconds_bucket{job=\"tripml-serving\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tripml_prediction_request_duration_seconds_bucket{job=\"tripml-serving\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Server error fraction (5xx)",
      "description": "5xx responses divided by all prediction responses. No traffic is undefined, not evidence of a healthy service. 4xx responses appear in the status panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(tripml_prediction_requests_total{job=\"tripml-serving\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(tripml_prediction_requests_total{job=\"tripml-serving\"}[$__rate_interval])))) / sum(rate(tripml_prediction_requests_total{job=\"tripml-serving\"}[$__rate_interval]))",
          "legendFormat": "5xx / all responses",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Static fallback fraction",
      "description": "Successful static predictions divided by successful predictions. Expected to be 100% for the batch release without valid Redis snapshots. No successful traffic is undefined.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tripml_feature_fallback_total{job=\"tripml-serving\"}[$__rate_interval])) / sum(rate(tripml_prediction_requests_total{job=\"tripml-serving\",status=\"200\"}[$__rate_interval]))",
          "legendFormat": "static / successful responses",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Feature lookup outcomes",
      "description": "Inspect missing, stale, invalid, unavailable, and successful feature lookup outcomes. Empty if online lookup is disabled.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(tripml_feature_lookup_total{job=\"tripml-serving\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Prediction publication outcomes",
      "description": "Acknowledged, disabled, or failed publication attempts as observed by the API. Broker acknowledgment does not establish consumer processing or exactly-once delivery.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(tripml_prediction_publication_total{job=\"tripml-serving\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Successfully scraped serving pods",
      "description": "A scrape health count, not Kubernetes desired or ready replicas. No discovered pods produces no data; inspect Kubernetes when targets disappear.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"tripml-serving\"})",
          "legendFormat": "scrape success",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "count(up{job=\"tripml-serving\"})",
          "legendFormat": "discovered targets",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prediction responses per pod",
      "description": "Per-pod completed traffic, useful when comparing Service distribution during scaling. Rates handle process counter resets.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(tripml_prediction_requests_total{job=\"tripml-serving\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Broker wait P95",
      "description": "Includes completed delivery waits, including failed attempts. Undefined if publication is disabled.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tripml_prediction_publication_duration_seconds_bucket{job=\"tripml-serving\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Accepted feature age P95",
      "description": "Age relative to pickup event time, not wall-clock freshness. Only accepted snapshots contribute; inspect lookup outcomes for rejected snapshots.",
      "datasource": {
        "type": "prometheus",
        "uid": "tripml-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tripml_feature_age_seconds_bucket{job=\"tripml-serving\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "tripml-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
